# tarot-service-api origin, no trailing slash.
# iOS simulator: http://127.0.0.1:3004
# Android emulator: http://10.0.2.2:3004
# Physical phone (Expo Go): http://<your Mac's LAN IP>:3004, on the same Wi-Fi. 127.0.0.1 and
# 10.0.2.2 are the phone itself and the emulator's gateway, so neither reaches your computer.
EXPO_PUBLIC_TAROT_BASE_URL=
EXPO_UNSTABLE_MCP_SERVER=1
